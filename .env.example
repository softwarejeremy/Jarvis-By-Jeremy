# ─────────────────────────────────────────────────────────────
#  J.A.R.V.I.S. — secretos.  Copia este archivo a `.env` y rellena.
#  `.env` está en .gitignore: nunca se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# OBLIGATORIO — tu API key de Anthropic.
# Se saca en https://console.anthropic.com  ->  Settings  ->  API Keys
# Hay que cargar saldo (desde 5 USD) en Billing para que funcione.
ANTHROPIC_API_KEY=sk-ant-...

# OPCIONAL — sólo si quieres la voz premium de ElevenLabs.
# Se saca en https://elevenlabs.io  ->  Profile  ->  API Key
# Sin esto, J.A.R.V.I.S. usa edge-tts, que es gratis y no necesita cuenta.
# ELEVENLABS_API_KEY=
# JARVIS_TTS__ENGINE=elevenlabs
# JARVIS_TTS__ELEVENLABS_VOICE_ID=

# ─── Ajustes rápidos (todo esto también se puede poner en config.toml) ───

# Modelo y profundidad de razonamiento.
# "low" es lo correcto para conversar: prioriza latencia sobre elaboración.
# JARVIS_AGENT__MODEL=claude-opus-5
# JARVIS_AGENT__EFFORT=low

# Tope de gasto por sesión, en dólares. El SDK corta al alcanzarlo.
# JARVIS_AGENT__MAX_BUDGET_USD=2.0

# Tamaño del modelo de transcripción: tiny | base | small | medium | large-v3
# "small" es el punto dulce en CPU para español. "tiny" si vas justo de máquina.
# JARVIS_STT__MODEL_SIZE=small

# Motor de voz: edge | sapi | elevenlabs
# JARVIS_TTS__ENGINE=edge
# JARVIS_TTS__VOICE=es-MX-JorgeNeural
